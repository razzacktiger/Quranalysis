# Copy this file to `.env.local` in each worktree folder (never commit `.env.local`).
#
#   cp .env.example .env.local
#
# Restart `npm run dev` after changing env vars.
#
# Where to find values:
#   Supabase → Project Settings → API (URL, anon key, service_role key)
#   Gemini   → https://aistudio.google.com/apikey
#   Vercel   → Project → Settings → Environment Variables (or `vercel env pull .env.local`)

# --- Supabase (required for auth, sessions, dashboard) ---
# Safe to expose in the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Used by API routes (e.g. AI chat). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Google Gemini (required for /api/ai/chat) ---
GEMINI_API_KEY=your_gemini_api_key
